{
  "version": 1,
  "note": "SDK 未覆盖、但官方文档存在的接口，手写进能力表。生成器（build_capabilities.py）会把它与 SDK 内省结果合并；**不要手改 src/mybmo_mcp/baidu/capabilities.json**。",
  "capabilities": {
    "PvSearchFunction.getPvSearch": {
      "service": "PvSearchFunction",
      "method": "getPvSearch",
      "endpoint": "/json/sms/service/PvSearchFunction/getPvSearch",
      "product_line": "sms",
      "mutating": "false",
      "group": "检索与工具",
      "body": "PvSearchRequest",
      "input_schema": {
        "$ref": "#/schemas/PvSearchRequest"
      }
    },
    "KeyWordShoppingService.getKeywordPackages": {
      "service": "KeyWordShoppingService",
      "method": "getKeywordPackages",
      "endpoint": "/json/sms/service/KeyWordShoppingService/getKeywordPackages",
      "product_line": "sms",
      "mutating": "false",
      "group": "电商推广投放",
      "body": "KWShopPackageQuery",
      "input_schema": {
        "$ref": "#/schemas/KWShopPackageQuery"
      }
    },
    "KeyWordShoppingService.addKeywordPackages": {
      "service": "KeyWordShoppingService",
      "method": "addKeywordPackages",
      "endpoint": "/json/sms/service/KeyWordShoppingService/addKeywordPackages",
      "product_line": "sms",
      "mutating": "true",
      "group": "电商推广投放",
      "body": "KWShopPackageAddRequest",
      "input_schema": {
        "$ref": "#/schemas/KWShopPackageAddRequest"
      }
    },
    "KeyWordShoppingService.updateKeywordPackages": {
      "service": "KeyWordShoppingService",
      "method": "updateKeywordPackages",
      "endpoint": "/json/sms/service/KeyWordShoppingService/updateKeywordPackages",
      "product_line": "sms",
      "mutating": "true",
      "group": "电商推广投放",
      "body": "KWShopPackageUpdateRequest",
      "input_schema": {
        "$ref": "#/schemas/KWShopPackageUpdateRequest"
      }
    },
    "KeyWordShoppingService.delKeywordPackages": {
      "service": "KeyWordShoppingService",
      "method": "delKeywordPackages",
      "endpoint": "/json/sms/service/KeyWordShoppingService/delKeywordPackages",
      "product_line": "sms",
      "mutating": "true",
      "group": "电商推广投放",
      "body": "KWShopPackageDelRequest",
      "input_schema": {
        "$ref": "#/schemas/KWShopPackageDelRequest"
      }
    }
  },
  "schemas": {
    "PvSearchRequest": {
      "type": "object",
      "properties": {
        "bidWordSource": {
          "type": "string",
          "enum": [
            "wordList"
          ],
          "description": "估算词的来源，目前只有 wordList"
        },
        "device": {
          "type": "integer",
          "enum": [
            0,
            1,
            2
          ],
          "description": "0 全部 / 1 仅移动 / 2 仅计算机"
        },
        "orderBy": {
          "type": "string",
          "enum": [
            "price",
            "matchType",
            "averageMonthPv",
            "averageMonthPvMobile",
            "averageMonthPvPc",
            "show",
            "click",
            "pcPrice",
            "mobilePrice"
          ],
          "description": "排序字段"
        },
        "order": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "description": "排序方向，默认 desc"
        },
        "keywordList": {
          "type": "array",
          "items": {
            "$ref": "#/schemas/PvSearchRequestWordItem"
          },
          "description": "要估算的关键词列表，1..1000 个"
        }
      },
      "required": [
        "bidWordSource",
        "keywordList"
      ]
    },
    "PvSearchRequestWordItem": {
      "type": "object",
      "properties": {
        "keywordName": {
          "type": "string",
          "description": "关键词字面，最大 40 字节（1 个中文算 2 字节）"
        },
        "matchType": {
          "type": "integer",
          "enum": [
            1,
            2
          ],
          "description": "1 精确 / 2 短语或智能，需与 phraseType 配合"
        },
        "phraseType": {
          "type": "integer",
          "enum": [
            1,
            3
          ],
          "description": "matchType=1 时只能是 1；matchType=2 时 1=短语、3=智能"
        }
      },
      "required": [
        "keywordName"
      ]
    },
    "KWShopPackageQuery": {
      "type": "object",
      "properties": {},
      "description": "实测无过滤参数：不传即返回该账户全部关键词包（汇总视图）"
    },
    "KWShopPackageItem": {
      "type": "object",
      "properties": {
        "packageId": {
          "type": "integer",
          "description": "关键词包 ID（更新/删除时必需）"
        },
        "packageName": {
          "type": "string",
          "description": "关键词包名称"
        },
        "keywordTypes": {
          "type": "array",
          "items": {
            "$ref": "#/schemas/KWShopPackageKeyword"
          },
          "description": "包内关键词；新建时每项 {keyword, id:0}"
        }
      }
    },
    "KWShopPackageAddRequest": {
      "type": "object",
      "properties": {
        "keywordPackageTypes": {
          "type": "array",
          "items": {
            "$ref": "#/schemas/KWShopPackageItem"
          },
          "description": "关键词包数组（实测字段名就是 keywordPackageTypes）"
        }
      }
    },
    "KWShopPackageUpdateRequest": {
      "type": "object",
      "properties": {
        "keywordPackageTypes": {
          "type": "array",
          "items": {
            "$ref": "#/schemas/KWShopPackageItem"
          },
          "description": "关键词包数组（实测字段名就是 keywordPackageTypes）"
        }
      }
    },
    "KWShopPackageDelRequest": {
      "type": "object",
      "properties": {
        "keywordPackageTypes": {
          "type": "array",
          "items": {
            "$ref": "#/schemas/KWShopPackageItem"
          },
          "description": "关键词包数组（实测字段名就是 keywordPackageTypes）"
        }
      },
      "description": "⚠ 删除的参数结构仍未确认：keywordPackageTypes[{packageId}] / keywordPackageIds / packageIds / ids 都返回 9015"
    },
    "KWShopPackageKeyword": {
      "type": "object",
      "properties": {
        "keyword": {
          "type": "string",
          "description": "关键词字面"
        },
        "id": {
          "type": "integer",
          "description": "关键词 ID，新建时填 0"
        }
      },
      "required": [
        "keyword"
      ]
    }
  }
}
