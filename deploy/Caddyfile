{
	email {$ACME_EMAIL}
}

# 站点地址从环境变量取，换域名只改 deploy/.env，不动这个文件。
{$MCP_HOST} {
	encode zstd gzip

	# 探活不鉴权：容器 HEALTHCHECK、外部监控、排障都要能直接打到。
	# 它不返回账户信息，只有版本、能力条数、凭据是否已配置。
	handle /healthz {
		reverse_proxy mcp:8000
	}

	handle {
		# Casdoor 上线前，这里是唯一的访问控制。
		# 没有它，MYBMO_AUTH_MODE=local 意味着任何知道域名的人都是全权管理员。
		basic_auth {
			{$MCP_USER} {$MCP_PASSWORD_HASH}
		}

		# Caddy 的反向代理默认不缓冲，SSE / Streamable HTTP 的长连接可以直接穿透。
		reverse_proxy mcp:8000
	}
}

# ---------------------------------------------------------------------------
# P4：Casdoor 上线后解除注释。它必须有自己的主机名——
# issuer 是 https://auth.pandabase.top，写进 JWT 的 iss，之后不可更改。
#
# auth.pandabase.top {
# 	reverse_proxy casdoor:8000
# }
# ---------------------------------------------------------------------------
