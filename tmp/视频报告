"startDate": "2026-01-01",
"endDate": "2026-01-07",
"timeUnit": "DAY",
"columns": ["date", "videoNameStatus", "videoInfo", "videoDuration", "userId", "userName", "campaignType", "videoId", "impression", "click", "cost", "ctr", "cpc", "cpm", "interaction", "completePlayCount", "completePlayRatio", "playCount1", "playCount2", "playCount3", "playCount4", "avgPlayTime", "manualPlayCount", "autoPlayCount", "effectivePlayCount", "completePlayCost"],
"sorts": [],
