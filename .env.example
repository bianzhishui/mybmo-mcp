# mybmo-mcp 环境变量示例。复制为 .env 后填写；.env 已被 .gitignore 排除。
# 取值约定：留空的项如果对应功能未启用，可以保持为空。

# 百度营销开放平台应用凭据（https://dev2.baidu.com 创建应用后获取）
# 用途：OAuth 换令牌、刷新令牌
BAIDU_APP_ID=
BAIDU_SECRET_KEY=

# 本地数据目录
# 用途：凭据库、审计 JSONL、导出文件；默认 ./data
MYBMO_DATA_DIR=./data

# 凭据加密主密钥（32 字节随机数的 base64）
# 生成：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# 丢失即所有已绑定账户失效，需重新授权
MYBMO_MASTER_KEY=

# Casdoor 授权服务器 issuer
# 必须与令牌 iss 完全一致（含协议、域名、端口），一旦上生产不可更改
# 示例：https://auth.example.com
CASDOOR_ISSUER=

# 本服务的公网规范地址
# 用途：JWT audience 校验、RFC 9728 元数据中的 resource 字段
# 示例：https://mcp.example.com
MYBMO_RESOURCE_URL=

# PostgreSQL 连接串（P4 接入 Casdoor 后启用）
# 示例：postgresql://mybmo:密码@127.0.0.1:5432/mybmo
MYBMO_DATABASE_URL=
