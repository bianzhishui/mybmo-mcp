# Casdoor 部署侧配置。复制为 deploy/casdoor/.env 后填写。
# 该文件含数据库口令，已被 .gitignore 排除。

# ---- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=casdoor
# 生成：openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- Casdoor -------------------------------------------------------------
# 必须与 DNS 一致，且**一旦启用不可更改**——它写进每个 JWT 的 iss（见 ADR 0001）。
# 改域名 = 所有已签发令牌失效 + 所有客户端要重新配置。
CASDOOR_ORIGIN=https://auth.pandabase.top
