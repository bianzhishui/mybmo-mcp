# mybmo-mcp 环境变量示例。复制为 .env 后填写；.env 已被 .gitignore 排除。
# 取值约定：留空的项如果对应功能未启用，可以保持为空。

# 百度营销开放平台应用凭据（https://dev2.baidu.com 创建应用后获取）
# 用途：OAuth 换令牌、刷新令牌
BAIDU_APP_ID=
BAIDU_SECRET_KEY=

# 百度 OAuth 的授权回调地址，用 mybmo-mcp auth bind 绑账户时才需要
# 必须与 dev2 应用「基本信息 → 安全设置」里登记的**根域**一致（百度按根域比对，
# 不一致报 redirect_uri_mismatch）；不能带 ? 或 %，附加信息走 state
# 本地开发若百度允许登记第二个地址，可填 http://localhost:8000/oauth/baidu/callback
# 示例：https://baiduads.pandabase.top/oauth/baidu/callback
MYBMO_BAIDU_CALLBACK_URL=

# 百度订阅（事件推送）的共享密钥，填进开发者中心「应用管理 → 配置订阅」里那个密钥
# 用途：/oauth/baidu/subscribe 收到推送时校验来源
# **不填则该端点返回 503**（失败关闭）：留空比留个默认值安全
# 它与 BAIDU_SECRET_KEY（应用密钥）、MYBMO_MASTER_KEY（凭据加密主密钥）互不相干
# 注意：这个端点只把报文打印并落盘到 data/subscribe/*.jsonl，不做任何业务动作
# 格式要求：**32 位，仅小写字母与数字**（百度控制台只收这种，别的格式存不进去）
# 生成：python3 -c "import secrets,string;print(''.join(secrets.choice(string.ascii_lowercase+string.digits) for _ in range(32)))"
MYBMO_BAIDU_SUBSCRIBE_SECRET=

# 本地数据目录
# 用途：凭据库、审计 JSONL、导出文件；默认 ./data
MYBMO_DATA_DIR=./data

# 凭据加密主密钥（32 字节随机数的 base64）
# 生成：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# 丢失即所有已绑定账户失效，需重新授权
MYBMO_MASTER_KEY=

# 身份模式，决定「你是谁」从哪里来
#   local（默认）= stdio 单用户，本机进程即本人，对全部账户有 admin
#   oidc          = 多用户，身份来自 JWT，权限由 data/tenancy.json 的 grants 决定
# 取这两个以外的值一律按多用户处理（失败关闭），拼错不会导致越权
MYBMO_AUTH_MODE=local

# Casdoor 授权服务器 issuer
# 必须与令牌 iss 完全一致（含协议、域名、端口；末尾斜杠会被规范化掉）
# 一旦启用不可更改——它写进每个 JWT，改一次所有客户端都要重新配置
# 只在 MYBMO_AUTH_MODE=oidc 时必填
# 示例：https://auth.pandabase.top
CASDOOR_ISSUER=

# 本服务的公网规范地址，用作 RFC 9728 元数据里的 resource 字段
# 只在 oidc 模式必填。**它不参与验签**——aud 校验用的是 MYBMO_OIDC_AUDIENCE
# 示例：https://baiduads.pandabase.top
MYBMO_RESOURCE_URL=

# JWT 的 audience **白名单**：填 IdP 里各 OAuth 应用的 clientId
# 注意：IdP 把 aud 填成 client_id，不是资源地址，见 docs/auth-contract.md
# 多个客户端用逗号分隔，每接入一个客户端就加一个（不走 DCR 自动注册）
# 示例：709a8e16656a223a1ab7
# oidc 模式下不填就拒绝启动
MYBMO_OIDC_AUDIENCE=

# 允许的 Casdoor 组织（逗号分隔）。本服务只服务 pandabase 组织的 mybmo-mcp 应用，
# 令牌 owner 不在列表里直接 401。留空 = 不校验组织
MYBMO_OIDC_ORGS=

# JWKS 地址。实测是 {issuer}/.well-known/jwks，与直觉的 /api/v1/jwks 不同
# 留空则按 /.well-known/jwks 推导；换授权服务器时建议显式指定
# 示例：https://auth.pandabase.top/.well-known/jwks
MYBMO_JWKS_URL=

# PostgreSQL 连接串（多租户落库时启用，见 pyproject 的 optional-dependencies.db）
# 库与角色由 infra 创建；容器内用服务名，宿主上用 127.0.0.1:5432（infra 已绑回环）
# 示例：postgresql://mybmo:密码@pandabase-postgres:5432/mybmo
MYBMO_DATABASE_URL=
