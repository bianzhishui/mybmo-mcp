# 仅 `--profile dedicated`（容器版 Caddy）时需要。
#
# 为什么不复用 deploy/.env：
# bcrypt 哈希含 `$`，写进 compose 的 `environment: ${VAR}` 会被当成变量插值
# （表现为 "The \"...\" variable is not set" 警告，且 basic auth 永远失败）。
# compose 的 env_file 原样注入，不插值，所以哈希放这里最安全。
#
# 生成：caddy hash-password --plaintext '密码'
# 复制为 deploy/.env.caddy，权限 600。

MCP_HOST=baiduads.pandabase.top
ACME_EMAIL=admin@pandabase.top
MCP_USER=mybmo
MCP_PASSWORD_HASH=$2a$14$REPLACE_WITH_REAL_HASH
