# 部署侧配置。复制为 deploy/.env 后填写；该文件含密钥，已被 .gitignore 排除。
#
# 与仓库根 .env.example 的区别：根目录那份是**本机开发**用的（相对路径、无域名）；
# 这份是**服务器**用的，多了域名与证书项，且数据目录由 compose 覆盖为 /data。

# ---- 域名与证书 ----------------------------------------------------------
# 必须先在 DNS 里把 A 记录指到服务器公网 IP，否则 Caddy 签证书会失败
MCP_HOST=baiduads.pandabase.top
# Let's Encrypt 到期提醒收件地址
ACME_EMAIL=

# ---- 访问控制（Casdoor 上线前）-------------------------------------------
# 这是当前唯一的门。留空 = 任何人都能用你的百度账户花钱。
MCP_USER=mybmo
# 生成方式（不要在别处复用这个密码）：
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '你的密码'
MCP_PASSWORD_HASH=

# ---- 运行时 --------------------------------------------------------------
# 32 字节随机数的 base64。丢失 = 所有已绑定账户失效，需重新授权
MYBMO_MASTER_KEY=
# local = 本机身份（当前部署形态）；oidc = 接 Casdoor 后切换
MYBMO_AUTH_MODE=local

BAIDU_APP_ID=
BAIDU_SECRET_KEY=

# P4 才会用到
CASDOOR_ISSUER=
MYBMO_RESOURCE_URL=https://baiduads.pandabase.top
MYBMO_DATABASE_URL=
