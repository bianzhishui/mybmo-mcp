# 业务部署配置。复制为 deploy/.env 后填写；该文件含密钥，已被 .gitignore 排除。
#
# 与仓库根 .env.example 的区别：根目录那份是**本机开发**用的（相对路径、无公网地址）；
# 这份是**服务器**用的，多了 issuer / JWKS / resource 这些由 infra 提供的值，
# 且数据目录由 compose 覆盖为 /data。
#
# 这些值的口径见 docs/auth-contract.md，改动前先看它。

# ---- 业务凭据 ------------------------------------------------------------
BAIDU_APP_ID=
BAIDU_SECRET_KEY=
# 32 字节随机数的 base64。丢失 = 所有已绑定账户失效，需重新授权
# 生成：python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
MYBMO_MASTER_KEY=

# ---- 百度账户绑定 --------------------------------------------------------
# 授权回调地址：必须与 dev2 应用「安全设置」里登记的根域一致（百度按根域比对）
# 同时 Caddy 必须把这个路径反代到容器，否则 404 发生在反代层、容器日志里看不到
MYBMO_BAIDU_CALLBACK_URL=https://baiduads.pandabase.top/oauth/baidu/callback

# ---- 百度订阅（事件推送）-------------------------------------------------
# 订阅地址：https://baiduads.pandabase.top/oauth/baidu/subscribe
# 密钥与它成对填写；不填则端点返回 503。当前只采样打印，不解析成业务动作
# 格式：32 位小写字母 + 数字（百度控制台的硬要求）
# 生成：python3 -c "import secrets,string;print(''.join(secrets.choice(string.ascii_lowercase+string.digits) for _ in range(32)))"
MYBMO_BAIDU_SUBSCRIBE_SECRET=

# ---- 身份（值由 infra 提供）---------------------------------------------
# 必须与令牌 iss 完全一致，一旦启用不可更改
CASDOOR_ISSUER=https://auth.pandabase.top
# 允许调用本服务的 client_id。**只放 mybmo-mcp 这一个**：
#   709a8e16656a223a1ab7  mybmo-mcp（pandabase 组织，本服务唯一入口）
# 不开 DCR，也不新增客户端应用——多一个 client_id 就等于多一个入口
MYBMO_OIDC_AUDIENCE=709a8e16656a223a1ab7
# 允许的 Casdoor 组织。本服务只对应 pandabase 组织下的 mybmo-mcp 应用，
# 令牌 owner 不是它就直接 401。留空则不校验（只靠上面的 aud 白名单）
MYBMO_OIDC_ORGS=pandabase
# 实测路径是 /.well-known/jwks，不要靠推导
MYBMO_JWKS_URL=https://auth.pandabase.top/.well-known/jwks
# RFC 9728 元数据里的 resource 字段
MYBMO_RESOURCE_URL=https://baiduads.pandabase.top

# ---- 数据库（多租户落库时启用，当前留空）---------------------------------
MYBMO_DATABASE_URL=
# 凭据落库的租户
MYBMO_TENANT_ID=t_default

# 构建时用的 PyPI 源（可选，pip 与 uv 共用）。国内服务器建议指向镜像，例如：
# PYPI_INDEX=https://mirrors.cloud.tencent.com/pypi/simple
# uv.lock 里记录的绝对下载地址也改写到镜像（可选）。腾讯云示例：
# PYPI_FILES_MIRROR=https://mirrors.cloud.tencent.com/pypi
