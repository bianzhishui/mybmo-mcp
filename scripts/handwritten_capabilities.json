{
  "version": 1,
  "note": "SDK 未覆盖、但官方文档存在的接口，手写进能力表。生成器（build_capabilities.py）会把它与 SDK 内省结果合并；**不要手改 src/mybmo_mcp/baidu/capabilities.json**。",
  "capabilities": {
    "PvSearchFunction.getPvSearch": {
      "service": "PvSearchFunction",
      "method": "getPvSearch",
      "endpoint": "/json/sms/service/PvSearchFunction/getPvSearch",
      "product_line": "sms",
      "mutating": "false",
      "group": "检索与工具",
      "body": "PvSearchRequest",
      "input_schema": { "$ref": "#/schemas/PvSearchRequest" }
    }
  },
  "schemas": {
    "PvSearchRequest": {
      "type": "object",
      "properties": {
        "bidWordSource": {
          "type": "string",
          "enum": ["wordList"],
          "description": "估算词的来源，目前只有 wordList"
        },
        "device": {
          "type": "integer",
          "enum": [0, 1, 2],
          "description": "0 全部 / 1 仅移动 / 2 仅计算机"
        },
        "orderBy": {
          "type": "string",
          "enum": [
            "price",
            "matchType",
            "averageMonthPv",
            "averageMonthPvMobile",
            "averageMonthPvPc",
            "show",
            "click",
            "pcPrice",
            "mobilePrice"
          ],
          "description": "排序字段"
        },
        "order": {
          "type": "string",
          "enum": ["asc", "desc"],
          "description": "排序方向，默认 desc"
        },
        "keywordList": {
          "type": "array",
          "items": { "$ref": "#/schemas/PvSearchRequestWordItem" },
          "description": "要估算的关键词列表，1..1000 个"
        }
      },
      "required": ["bidWordSource", "keywordList"]
    },
    "PvSearchRequestWordItem": {
      "type": "object",
      "properties": {
        "keywordName": {
          "type": "string",
          "description": "关键词字面，最大 40 字节（1 个中文算 2 字节）"
        },
        "matchType": {
          "type": "integer",
          "enum": [1, 2],
          "description": "1 精确 / 2 短语或智能，需与 phraseType 配合"
        },
        "phraseType": {
          "type": "integer",
          "enum": [1, 3],
          "description": "matchType=1 时只能是 1；matchType=2 时 1=短语、3=智能"
        }
      },
      "required": ["keywordName"]
    }
  }
}
